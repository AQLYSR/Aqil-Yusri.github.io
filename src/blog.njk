---
title: Blog
layout: "base.njk"
---
    <main>
        <h1>Blog</h1>
        <p>No blog posts yet. Check back later!</p>
	<ul role="list" class="articles_list flow">
		{% for post in collections.post | reverse %}
		<li class="article">
			<article class="snippet">
				<a href={{ post.url}}>{{ post.data.title }}</a>
			</article>
		</li>
		{% endfor %}
	</ul>
    </main>
